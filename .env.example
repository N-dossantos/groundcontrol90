# Copiar a .env y completar con valores reales antes de levantar docker-compose.prod.yml
# Nunca commitear el .env real.

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=ecommerce_db
MYSQL_USER=user_app
MYSQL_PASSWORD=

SPRING_DATASOURCE_USERNAME=user_app
SPRING_DATASOURCE_PASSWORD=

# Generar con: openssl rand -base64 64
JWT_SECRET=

# Dominio real de producción, separado por comas si hay más de uno
CORS_ALLOWED_ORIGINS=https://tu-dominio.com

# Dominio real apuntado por DNS a este servidor (A record)
DOMAIN=tu-dominio.com

# Credenciales de Mercado Pago (panel de desarrolladores > tu aplicación)
# https://www.mercadopago.com.ar/developers/panel/app
# El access token y el webhook secret son secretos: nunca llegan al navegador.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Se genera en el panel al configurar la notificación de webhooks
MERCADOPAGO_WEBHOOK_SECRET=

# URLs públicas del stack: el comprador vuelve del checkout al frontend y
# Mercado Pago le pega al webhook del backend, así que ninguna puede ser localhost
FRONTEND_URL=https://tu-dominio.com
BACKEND_URL=https://tu-dominio.com

# Servidor SMTP para los mails transaccionales (bienvenida, confirmación de pedido,
# cambios de estado). Obligatorias: sin estas variables el backend no arranca en prod.
# Ej. Gmail: smtp.gmail.com / 587 / la cuenta / una contraseña de aplicación.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Remitente que ve el comprador
MAIL_FROM=no-reply@tu-dominio.com

# Imágenes publicadas por CI en GitHub Container Registry al mergear a main.
# Reemplazar "tu-org" por el owner real del repositorio en GitHub.
BACKEND_IMAGE=ghcr.io/tu-org/ecommerce-backend:latest
FRONTEND_IMAGE=ghcr.io/tu-org/ecommerce-frontend:latest

# Backups (opcional pero recomendado en producción real)
BACKUP_DIR=/var/backups/ecommerce-mysql
BACKUP_RETENCION_DIAS=7
# Sin bucket, el backup queda solo en el disco del servidor: no protege contra
# perder el servidor entero.
BACKUP_S3_BUCKET=
# Solo para proveedores S3-compatibles que no son AWS (Backblaze B2, DO Spaces...)
BACKUP_S3_ENDPOINT=

# Solo para docker-compose.yml (desarrollo): en prod los puertos los publica el proxy
BACKEND_PORT=8081
FRONTEND_PORT=80
