# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Sin barra inicial: con "/node_modules" el patrón queda anclado a la raíz y no cubre
# frontend/node_modules/, así que un `git add .` subía el árbol entero de dependencias.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
#/tpo-commits/

# production
# Mismo motivo que node_modules: sin anclar, para que cubra frontend/dist/ y frontend/build/
build/
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Maven
backend/target/

# Imágenes subidas por los vendedores en desarrollo (en producción viven en un
# volumen de Docker, ver docker-compose.prod.yml)
backend/uploads/
uploads/

# Herramientas de agentes: los worktrees son copias completas del repo
.claude/
# Superpowers SDD workspace (scratch)
.superpowers/
